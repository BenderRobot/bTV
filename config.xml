<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://yourdomain/MyIPtv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="bfgs9jFN9d.MyIPtv" package="bfgs9jFN9d" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
    <name>MyIPtv</name>
    <tizen:profile name="tv"/>

    <!-- Privilèges obligatoires pour l'IPTV (Accès Internet et gestion des flux) -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <!-- OBLIGATOIRE : Autorise l'accès à n'importe quel domaine distant -->
    <access origin="*" subdomains="true"/>
    
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>